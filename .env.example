# Bu dosyayı ".env" adıyla kopyala ve GERÇEK, GÜÇLÜ değerlerle doldur:
#   cp .env.example .env
#
# .env dosyasını ASLA git'e gönderme! (secret içerir — .gitignore'da zaten hariç tutuldu)
#
# Güçlü değer üretmek için (terminalde):
#   openssl rand -base64 32

# Mongo yönetici kullanıcısı
MONGO_USERNAME=admin
MONGO_PASSWORD=buraya_guclu_bir_sifre

# JWT imza anahtarı — en az 32 karakter, rastgele
JWT_KEY=buraya_en_az_32_karakterlik_rastgele_gizli_anahtar
